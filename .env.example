# Keystatic GitHub mode (production only; local dev uses the filesystem)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Contact form (https://web3forms.com, free). Without it the form opens a mailto: link.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Your custom domain, used for the sitemap, canonical URLs and social previews
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Set to "github" to use GitHub storage in `pnpm dev` (needed once, to create the GitHub App)
# NEXT_PUBLIC_KEYSTATIC_STORAGE=github
